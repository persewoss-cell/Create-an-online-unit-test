{
  "name": "online-unit-test",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "predev": "node scripts/copy-pdfjs-assets.mjs",
    "dev": "vite",
    "prebuild": "node scripts/copy-pdfjs-assets.mjs",
    "build": "vite build",
    "preview": "vite preview",
    "test": "vitest run",
    "emulators": "firebase emulators:start --only auth,firestore --project demo-unit-test",
    "deploy": "npm run build && firebase deploy --only hosting,firestore,auth",
    "test:rules": "node scripts/test-rules.mjs",
    "dev:emulator": "VITE_USE_EMULATOR=true vite"
  },
  "dependencies": {
    "exceljs": "^4.4.0",
    "firebase": "^12.19.0",
    "pdfjs-dist": "^6.3.289",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "react-router-dom": "^7.18.4"
  },
  "devDependencies": {
    "@vitejs/plugin-react": "^6.1.1",
    "firebase-tools": "^15.32.0",
    "vite": "^8.3.1",
    "vitest": "^5.0.2"
  }
}
